# Copy this to .env and fill it in: cp .env.example .env   (.env stays out of git)

# Cloud API keys - make each with: openssl rand -hex 16
# Upload them to Cloudflare with: npm run secrets -w @cyber-dragon/api
# Read-only, handed to students each lesson
STUDENT_KEY=
# The Pis' write key
PI_KEY=

# This Pi
PLC_ID=PLC001
# Printed when you deploy the API, e.g. https://plc-api.<subdomain>.workers.dev
API_URL=
