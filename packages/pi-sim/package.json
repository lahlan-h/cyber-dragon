{
  "name": "@cyber-dragon/pi-sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently -k -n bridge,server \"npm run bridge\" \"npm run server\"",
    "bridge": "BRIDGE_HOST=0.0.0.0 node src/index.js",
    "server": "docker run --rm --init --name cyber-dragon-pi -p 3000:3000 --add-host=host.docker.internal:host-gateway cyber-dragon-pi",
    "build": "docker build -t cyber-dragon-pi --build-arg CACHEBUST=$(date +%s) ../..",
    "shell": "docker run --rm -it --add-host=host.docker.internal:host-gateway cyber-dragon-pi bash",
    "info": "docker run --rm -it --add-host=host.docker.internal:host-gateway cyber-dragon-pi stm32flash -m 8n1 /dev/ttyVIRTUAL",
    "probe": "node scripts/probe.js"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5"
  }
}
