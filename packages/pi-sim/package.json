{
  "name": "@cyber-dragon/pi-sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bridge": "BRIDGE_HOST=0.0.0.0 node src/index.js",
    "probe": "node scripts/probe.js",
    "docker:build": "docker build -t cyber-dragon-pi --build-arg CACHEBUST=$(date +%s) ../..",
    "docker:run": "docker run --rm -it -p 3000:3000 --add-host=host.docker.internal:host-gateway cyber-dragon-pi",
    "docker:info": "docker run --rm -it --add-host=host.docker.internal:host-gateway cyber-dragon-pi stm32flash -m 8n1 /dev/ttyVIRTUAL",
    "docker:up": "docker run --rm --init -p 3000:3000 --add-host=host.docker.internal:host-gateway cyber-dragon-pi",
    "dev:sim": "concurrently -k -n bridge,server \"npm run bridge\" \"npm run docker:up\""
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5"
  }
}
